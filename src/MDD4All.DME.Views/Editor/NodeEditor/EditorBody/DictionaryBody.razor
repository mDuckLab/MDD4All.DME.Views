@namespace MDD4All.DME.Views.Editor
@using MDD4All.DME.ViewModels.Editor
@inherits MDD4All.DME.Views.Localization.LocalizedComponent

<div class="dictionary-table">
    @if (this.ViewModel.Children?.Any() == true)
    {
        @if (ViewModel.IsKeyTypeSimple && ViewModel.IsValueTypeSimple)
        {
            <div class="flush-content-wrapper">
                @* Tabellen-Header mit Trennstrich-Logik im CSS *@
                <div class="dict-header">
                    <div class="header-cell">@L["Editor.KeyColumn"]</div>
                    <div class="header-cell">@L["Editor.ValueColumn"]</div>
                    <div class="action-placeholder"></div>
                </div>

                @foreach (var child in this.ViewModel.Children)
                {
                    if (child is DictionaryEntryViewModel entryViewModel)
                    {
                        <DictionaryEntryView DataContext="@entryViewModel"
                                 DeleteMode="@DeleteMode"
                                 MaxDepth="@MaxDepth"
                                 CurrentDepth="@CurrentDepth" />
                    }
                }
            </div>
        }
        else if (ViewModel.IsKeyTypeSimple && !ViewModel.IsValueTypeSimple)
        {
            @foreach (var child in this.ViewModel.Children)
            {
                if (child is DictionaryEntryViewModel entryViewModel)
                {
                    <DictionaryEntryCardView DataContext="@entryViewModel"
                             MaxDepth="@MaxDepth"
                             CurrentDepth="@CurrentDepth" />
                }
            }
        }
        else
        {
            @* Complex key - key and value each get their own card, stacked. *@
            @foreach (var child in this.ViewModel.Children)
            {
                if (child is DictionaryEntryViewModel entryViewModel)
                {
                    <DictionaryComplexEntryCardView DataContext="@entryViewModel"
                             MaxDepth="@MaxDepth"
                             CurrentDepth="@CurrentDepth" />
                }
            }
        }
    }

</div>