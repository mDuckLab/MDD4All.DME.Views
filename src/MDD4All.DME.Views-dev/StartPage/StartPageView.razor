@namespace MDD4All.DME.Views.StartPage
@inherits MDD4All.DME.Views.Localization.LocalizedComponent

<div class="mainGrid">
    <div class="logo">
        <img src="images/Synorvia_logo.png" width="200" style="margin-left: -20px;margin-top:-50px;"/>
        <button class="wb-btn-reset" title="@L["Tooltip.Settings"]" type="button" @onclick="@(() => OnSettingsRequested.InvokeAsync())">
            <i class="bi bi-gear-fill"></i>
        </button>
    </div>
    <div class="curentDataModel">
        @L["StartPage.CurrentDataModel"]<br/>
        @if(Settings.CurrentDataModel == null)
        {
            <span class="currentDataModelTitle">@L["StartPage.NothingSelected"]</span>
        }
        else
        {
            <span class="currentDataModelTitle"><i class="bi bi-x-diamond-fill"></i> @Settings.CurrentDataModel.FullTypeName</span>
        }

    </div>
    <div class="dataModelMainHeader">
        @L["StartPage.DataModel"]
    </div>
    <div class="dataModelSubHeader">
        @L["StartPage.OpenDataModelSub"]
    </div>
    <div class="dataModelCommands">
        <div class="commandLink"
             @onclick="() => Model.OpenDataModelCommand.Execute(null)">@L["StartPage.OpenDataModel"]</div>
    </div>
    <div class="dataModelRecentHeader">
        @L["StartPage.RecentDataModels"]
    </div>
    <div class="dataModelRecentEntries">
        @for(int counter = 0; counter < Settings.RecentDataModels.Count(); counter++)
        {
            int index = counter;
            Configurations.DataModelDescriptor descriptor = Settings.RecentDataModels[index];
            <div class="commandLink"
                 @onclick="() => Model.SetDataModelFromRecentListCommand.Execute(index)">@descriptor.FullTypeName</div>
        }
    </div>

    <div class="dataFileMainHeader">
        @L["StartPage.DataEditor"]
    </div>
    <div class="dataFileSubHeader">
        @L["StartPage.EditDataFileSub"]
    </div>
    <div class="dataFileCommands">
        <div class="commandLink"
             @onclick="() => DataFile.NewDataFileCommand.Execute(null)">@L["StartPage.CreateNewFile"]</div>

        <div class="commandLink"
             @onclick="() => DataFile.OpenDataFileCommand.Execute(null)">@L["StartPage.OpenExistingFile"]</div>
    </div>
    <div class="dataFileRecentHeader">
        @L["StartPage.RecentDataFiles"]
    </div>
    <div class="dataFileRecentEntries">
        @for (int counter = 0; counter < Settings.RecentDataFiles.Count(); counter++)
        {
            int index = counter;
            Configurations.DataFileDescriptor descriptor = Settings.RecentDataFiles[index];
            <div class="commandLink"
                 @onclick="() => DataFile.OpenRecentDataFileCommand.Execute(index)">
                @descriptor.FilePath
            </div>
        }
    </div>


</div>


