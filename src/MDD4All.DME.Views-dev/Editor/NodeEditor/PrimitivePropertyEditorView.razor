@namespace MDD4All.DME.Views.Editor
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@inherits MDD4All.DME.Views.Localization.LocalizedComponent

<div class="property-row @(IsCompact ? "compact-mode" : "") @(ViewModel.IsReadOnly ? "readonly" : "")"
     title="@(ViewModel.IsReadOnly ? L["Tooltip.ReadOnly"] : null)">
    @*<label class="property-label">@ViewModel.Title</label>*@



    @if (ShowTitle)
    {
        <label>
            <small>
                @if (Settings.ShowIndexNumbers) { @ViewModel.Level }
                @if (Settings.ShowIcons) { <EditorTreeIcon DataContext="ViewModel" /> }
            </small>
            @ViewModel.Title
            @if (ViewModel.IsReadOnly && Settings.ShowReadOnlyBadges)
            {
                <span class="readonly-badge">readonly</span>
            }
        </label>
    }

    <div class="property-input-zone" style="@(IsCompact ? "flex-grow: 1; display: flex;" : "")">
    <fieldset disabled="@ViewModel.IsReadOnly" style="border:none; margin:0; padding:0;">
        @if (ViewModel.Type!.IsEnum)
        {
            <select class="form-control form-select"
                    @onchange="@(e => ViewModel.Item = Enum.Parse(ViewModel.Type, e.Value?.ToString() ?? ""))">
                @foreach (var value in Enum.GetValues(ViewModel.Type))
                {
                    <option value="@value" selected="@(value.Equals(ViewModel.Item))">@value</option>
                }
            </select>
        }
        else
        {

            @switch (Type.GetTypeCode(ViewModel.Type))
            {
                case TypeCode.Boolean:
                    <input type="checkbox" class="form-check-input"
                           checked="@((bool)(ViewModel.Item ?? false))"
                           @onchange="@(e => ViewModel.Item = (bool)(e.Value ?? false))" />
                    break;

                case TypeCode.DateTime:
                    @* [DataType] narrows what is asked for: a birthday wants no clock, an alarm
                       no calendar. Without one, both halves stay on offer. *@
                    <input type="@DateInputType()"
                           class="form-control @(_localValueIsValid ? "" : "is-invalid")"
                           value="@DateInputValue()"
                           @onchange="@(e => OnDateTimeChanged(e.Value?.ToString()))" />
                    break;

                case TypeCode.Int16:
                case TypeCode.Int32:
                case TypeCode.Int64:
                case TypeCode.SByte:
                    <input type="number" step="1"
                           class="form-control @(_localValueIsValid ? "" : "is-invalid")"
                           onkeydown="if(event.key==='.' || event.key===',') event.preventDefault();"
                           value="@_localValue"
                           @oninput="OnInput"
                           @onchange="@(e => OnIntegerChanged(e.Value?.ToString()))" />
                    break;

                case TypeCode.Byte:
                case TypeCode.UInt16:
                case TypeCode.UInt32:
                case TypeCode.UInt64:
                    <input type="number" step="1" min="0"
                           class="form-control @(_localValueIsValid ? "" : "is-invalid")"
                           pattern="[0-9]*"
                           onkeydown="if(event.key==='.' || event.key===',' || event.key==='-') event.preventDefault();"
                           value="@_localValue"
                           @oninput="OnInput"
                           @onchange="@(e => OnIntegerChanged(e.Value?.ToString()))" />
                    break;

                case TypeCode.Single:
                case TypeCode.Double:
                case TypeCode.Decimal:
                    <input type="number" step="any"
                           class="form-control @(_localValueIsValid ? "" : "is-invalid")"
                           value="@_localValue"
                           @oninput="OnInput"
                           @onchange="@(e => OnDecimalChanged(e.Value?.ToString()))" />
                    break;

                default:
                    @* Use local value for text to handle rejected inputs (snap-back) *@
                    if (ViewModel.DataTypeAnnotation == "Password")
                    {
                        <input type="password"
                               class="form-control @(_localValueIsValid ? "" : "is-invalid")"
                               value="@_localValue"
                               @oninput="OnInput"
                               @onchange="OnCommit"
                               @onblur="OnBlur" />
                    }
                    else if (ViewModel.DataTypeAnnotation == "MultilineText")
                    {
                        <textarea type="text"
                                  class="form-control multiline @(_localValueIsValid ? "" : "is-invalid")"
                                  rows="3"
                                  value="@_localValue"
                                  @oninput="OnInput"
                                  @onchange="OnCommit"
                                  @onblur="OnBlur" />
                    }
                    else
                    {
                        <input type="text"
                               class="form-control @(_localValueIsValid ? "" : "is-invalid")"
                               value="@_localValue"
                               @oninput="OnInput"
                               @onchange="OnCommit"
                               @onblur="OnBlur" />
                    }
                    break;
            }
        }
    </fieldset>

    @* One line per rule the last input broke. The field has already snapped back to the value
       still in the model, so this says why nothing changed. *@
    @if (ViewModel.BrokenRules.Count > 0)
    {
        <ul class="validation-messages">
            @foreach (ValidationAttribute rule in ViewModel.BrokenRules)
            {
                <li>@Describe(rule)</li>
            }
        </ul>
    }
    </div>
</div>