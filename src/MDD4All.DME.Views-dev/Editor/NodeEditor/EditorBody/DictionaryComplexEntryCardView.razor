@namespace MDD4All.DME.Views.Editor
@using MDD4All.DME.ViewModels.Editor
@using MDD4All.UI.Buttons
@inherits MDD4All.DME.Views.Localization.LocalizedComponent

@* Key and value are both objects here, so neither fits into a table cell. They get a card each,
   stacked, with the entry's delete button on the key - removing a key removes the whole entry. *@
<div class="dict-complex-entry">

    <div class="dict-part dict-part-key">
        <div class="dict-part-header @(!ShowKeyExpander ? "no-toggle" : "")" @onclick="ToggleKey">
            @if (ShowKeyExpander)
            {
                <div class="expander-icon" title="@(IsKeyExpanded ? L["Tooltip.Collapse"] : L["Tooltip.Expand"])">
                    @(IsKeyExpanded ? "▼" : "▶")
                </div>
            }
            else
            {
                <div class="expander-icon"></div>
            }

            <div class="dict-part-label">@L["Editor.KeyColumn"]</div>

            <div class="dict-part-actions" @onclick:stopPropagation="true">
                <ToolbarButton Action="ToolbarButton.ToolbarAction.Delete"
                               OnActionTriggered="OnDeleteEntry"
                               Tooltip="@L["Tooltip.DeleteEntry"]" />
            </div>
        </div>

        @if (DataContext.KeyEditor != null)
        {
            <ObjectEditorView ViewModel="@DataContext.KeyEditor"
                              ShowOwnHeader="false"
                              MaxDepth="@MaxDepth"
                              CurrentDepth="@(CurrentDepth + 1)" />
        }
    </div>

    <div class="dict-part dict-part-value">
        <div class="dict-part-header @(!ShowValueExpander ? "no-toggle" : "")" @onclick="ToggleValue">
            @if (ShowValueExpander)
            {
                <div class="expander-icon" title="@(IsValueExpanded ? L["Tooltip.Collapse"] : L["Tooltip.Expand"])">
                    @(IsValueExpanded ? "▼" : "▶")
                </div>
            }
            else
            {
                <div class="expander-icon"></div>
            }

            <div class="dict-part-label">@L["Editor.ValueColumn"]</div>
        </div>

        @if (DataContext.ValueEditor != null)
        {
            <ObjectEditorView ViewModel="@DataContext.ValueEditor"
                              ShowOwnHeader="false"
                              MaxDepth="@MaxDepth"
                              CurrentDepth="@(CurrentDepth + 1)" />
        }
    </div>

</div>
