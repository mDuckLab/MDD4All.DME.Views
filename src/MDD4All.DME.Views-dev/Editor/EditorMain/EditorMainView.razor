@namespace MDD4All.DME.Views.Editor
@using MDD4All.DME.ViewModels
@using MDD4All.DME.ViewModels.Editor
@using MDD4All.DME.ViewModels.DataManager
@using MDD4All.UI.Breadcrumb
@using MDD4All.DME.Views.DataManager
@using MDD4All.UI.BlazorComponents.Tree
@using MDD4All.UI.DataModels.Tree
@inherits MDD4All.DME.Views.Localization.LocalizedComponent

<div class="workbench-grid">

    @* --- TOP TOOLBAR --- *@
    <header class="top-toolbar">
        <div class="tool-group">
            <EditorMainToolbar />
        </div>

        <TreeDisplayToggle @bind-Active="ExplorerSettings.ShowIcons"
                           Label="@L["Explorer.ShowIcons"]" />

        <EditorDepthStepperView @bind-Value="EditorSettings.MaxDepth" Limit="Editor.MaxSelectableDepth"
                                Label="@L["Editor.VisibleDepth"]" />

        <button class="wb-btn-reset" title="@L["Tooltip.Settings"]" type="button" @onclick="@(() => Navigation.OpenSettings())">
            <i class="bi bi-gear-fill"></i>
        </button>
    </header>

    @* --- BREADCRUMB AREA --- *@
    <section class="breadcrumb-area">
        @if (Editor.TreeViewModel?.SelectedNodeParentList != null)
        {
            <BreadcrumbView Path="Editor.TreeViewModel.SelectedNodeParentList"
                            TitleSelector="@(node => ((ObjectEditorViewModel)node).Title)" />
        }
    </section>

    @* --- EXPLORER SIDEBAR --- *@
    <aside class="explorer-area">
        <div class="panel-header">@L["Panel.Explorer"]</div>
        <div class="explorer-content">
            @if (Editor.TreeViewModel != null)
            {
                <MvvmTree TNode="ObjectEditorViewModel"
                          DataContext="@Editor.TreeViewModel"
                          SelectedNodeChanged="OnTreeSelectionChange"
                          ShowTreeIcons="@ExplorerSettings.ShowTypeSymbols"
                          TypeSymbolSelector="GetTypeSymbol">
                    <TitleTemplate Context="node">@if (ExplorerSettings.ShowIndexNumbers) { @node.Level } @if (ExplorerSettings.ShowIcons) { <EditorTreeIcon DataContext="node" /> }@node.Title</TitleTemplate>
                </MvvmTree>
            }
        </div>
    </aside>

    @* --- INTERACTIVE RESIZER --- *@
    <div class="resizer-handle" @onmousedown="StartResizing"></div>

    @* --- MAIN EDITOR AREA --- *@
    <main class="editor-area">
        @if (Editor.ShowRawData)
        {
            <div class="panel-header">
                @L["Panel.RawData"] &nbsp;&nbsp;

                    JSON &nbsp;<div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox"
                               @bind="Editor.ShowXml"/> </div>
                    XML

            </div>
            <div class="editor-body">
                <RawDataView DataContext="DataFile" />
            </div>
        }
        else
        {
            <div class="panel-header">@L["Panel.Editor"]</div>
            <div class="editor-body">
                @if (Editor.SelectedEditorViewModel != null)
                {
                    <ObjectEditorView ViewModel="@((ObjectEditorViewModel)Editor.SelectedEditorViewModel)"
                                      MaxDepth="@EditorSettings.MaxDepth"
                                      CurrentDepth="1" />
                }
                else
                {
                    <div class="p-5 text-center text-muted">
                        @L["Editor.SelectToBegin"]
                    </div>
                }
            </div>
        }
    </main>

    <div class="status-bar-area">
        <StatusBarView DataContext="DataFile" />
    </div>
</div>
