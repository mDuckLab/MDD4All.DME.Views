@namespace MDD4All.DME.Views.Editor
@using MDD4All.UI.BlazorComponents.Localization
@inherits MDD4All.DME.Views.Localization.LocalizedComponent
<div>

    <img src="images/Synorvia_icon.png"
        class="btn btn-outline-secondary startButton" 
        @onclick="() => Navigation.ShowStartPage()" />

    <button class="btn btn-outline-primary btn-sm"
            @onclick="() => DataFile.SaveDataFileCommand.Execute(null)">
        <i class="bi bi-save-fill"></i>
        @L["Toolbar.Save"]
    </button>

    <button class="btn btn-outline-secondary btn-sm"
            @onclick="() => DataFile.SaveDataFileAsCommand.Execute(null)">
        <i class="bi bi-save"></i>
        @L["Toolbar.SaveAs"]
    </button>

    <div class="btn-group" role="group" aria-label="Basic radio toggle button group" style="margin-left:20px;">
        <input type="radio" class="btn-check" name="btnradio" id="btnradio1" autocomplete="off" checked
               @onclick="() => Editor.ShowRawData = false">
        <label class="btn btn-outline-dark btn-sm" for="btnradio1">@L["Toolbar.Editor"]</label>

        <input type="radio" class="btn-check" name="btnradio" id="btnradio3" autocomplete="off"
               @onclick="() => Editor.ShowRawData = true">
        <label class="btn btn-outline-dark btn-sm" for="btnradio3">@L["Toolbar.RawData"]</label>
    </div>


</div>


